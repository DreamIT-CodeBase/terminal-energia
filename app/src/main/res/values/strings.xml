    <!--
      The image-filter override. Two mutually exclusive checkboxes; both off is AUTO and is the default.
      The status line is not decoration: two unticked boxes look the same as a screen nobody has set up,
      and here that IS the automatic state, so it has to be said in words rather than implied.
    -->
    <string name="filter_day">DAY FILTER</string>
    <string name="filter_night">NIGHT FILTER</string>
    <string name="filter_status_auto">ACTIVE FILTER: AUTO</string>
