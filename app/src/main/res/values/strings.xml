    <!--
      The station map and the sun times: the two pieces of reference data the app refreshes overnight
      (02:00 and 03:00 Tallinn) and the only two a field tester ever needs to force by hand. The readouts
      above each button say what is currently held, because a refresh button that reports nothing leaves
      "it worked" and "it failed silently" looking identical.
    -->
    <string name="menu_data_banner">REFERENCE DATA</string>
    <string name="action_refresh_map">Refresh station map</string>
    <string name="action_refresh_sun_times">Refresh sun times</string>
    <string name="data_working">Refreshing…</string>

    <!-- The sun-times readout. Two lines: the times themselves, then which day they belong to. -->
    <string name="sun_times">SUNRISE %1$s  ·  SUNSET %2$s</string>
    <string name="sun_times_none">SUN TIMES: none stored</string>
    <string name="sun_times_unreadable">SUN TIMES: stored, but unreadable</string>
    <string name="sun_times_no_key">No Azure Maps key in this build — sun times cannot be fetched.</string>
    <string name="sun_times_refreshed">Sun times refreshed — sunrise %1$s, sunset %2$s.</string>
    <string name="sun_times_failed">Could not refresh sun times (%1$s). The stored times are still in use.</string>
    <string name="no_reason_given">no reason given</string>

    <!-- The station map readout: what the location trigger can currently fire on. -->
    <string name="station_map">STATION MAP: %1$d station(s)</string>
    <string name="station_map_none">STATION MAP: empty — the location trigger cannot fire.</string>
    <string name="station_map_refreshed">Station map refreshed — %1$d from the API (%2$d new, %3$d updated, %4$d removed) · %5$d rows in the table.</string>
    <string name="station_map_failed">Could not refresh the station map. The stored one is still in use.</string>
    <string name="station_map_empty">The server returned no stations — keeping the stored map.</string>
    <string name="station_map_no_key">No API credentials in this build — the station map cannot be fetched.</string>

    <!--
      The tunables document. Its readout names what is IN FORCE, which is not necessarily what is on
      disk: a fetched document is stored and only applied at the next start, so the button has to say
      that rather than imply the values changed under the operator.
    -->
    <string name="action_refresh_config">Refresh config</string>
