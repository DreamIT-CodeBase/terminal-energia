<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the hovering error banner. Deliberately has no dismiss control: an error leaves the list
  when the condition behind it is fixed (ErrorLog.removeError), not when somebody swipes it away. A
  dismissable banner would let a live outage be hidden.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/errorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnErrorContainer"
        tools:text="Auto capture needs location all the time."
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/errorSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.75"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnErrorContainer"
        tools:text="LocationTrigger · 18:42"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
