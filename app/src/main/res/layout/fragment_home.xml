<?xml version="1.0" encoding="utf-8"?>
<!--
  The home panel. A readout, then five slabs in the order a unit is used: identify it, look at the
  tools, check what is wrong, lock it down, shut it off.

  Kiosk sits fourth on purpose. It is the last thing done before the device is left alone, and putting
  it above the diagnostics would mean pinning the app before checking whether it can actually work.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ts_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Three facts, each of which can be wrong on its own. No app name: the title bar says it. -->
        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ts_surface"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.TerminalScout.Readout"
            tools:text="KIOSK STATUS        : ON\nBACKGROUND SERVICES : 5/5\nMAPPED STATIONS     : 349" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupDevice"
            style="@style/Widget.TerminalScout.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_setup_device" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMenu"
            style="@style/Widget.TerminalScout.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_open_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewErrors"
            style="@style/Widget.TerminalScout.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_view_errors" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKiosk"
            style="@style/Widget.TerminalScout.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_enter_kiosk" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitDevice"
            style="@style/Widget.TerminalScout.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_exit_device" />

    </LinearLayout>
</ScrollView>
