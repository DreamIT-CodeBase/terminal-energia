# ============================================================
# MICROSOFT ENTRA ID (AZURE AD) SIGN IN
# ============================================================

# Random secret used to sign the session cookie.
# Generate with: npx auth secret
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# App registration in the Azure portal (Entra ID > App registrations).
AUTH_MICROSOFT_ENTRA_ID_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=REPLACE_WITH_CLIENT_SECRET
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0

# The only account allowed to sign in.
ALLOWED_EMAIL=chirag@dreamitcs.com

# Public URL of this app. Required in production so Auth.js builds the
# correct redirect URI.
# AUTH_URL=https://labelling.example.com

# TEMPORARY: set to true to bypass Microsoft sign-in entirely, so testers can
# use the tool without an Entra account. The app becomes OPEN -- anyone with
# the URL can browse the videos and submit annotations. Remove it, or set it
# to false, to restore enforcement. Nothing else needs changing.
# AUTH_DISABLED=true

# TEMPORARY: set to true to offer every video in the debug directory, including
# ones already annotated. Normally the queue is work still to do. With this on
# a video can be labelled again, and submitting overwrites what is already in
# that week's snapshot for it.
# SHOW_ALL_VIDEOS=true

# ============================================================
# SYSTEM API
#
# All Azure Blob Storage access goes through this service. The
# storage connection string is configured there, never here.
# ============================================================

SYSTEM_API_URL=http://127.0.0.1:8100
SYSTEM_API_KEY=REPLACE_WITH_THE_SAME_KEY_AS_SYSTEM_API

# The fleet secret, used server-side only to broker a device token for the
# device-config read (/v1/config) the station map draws the trigger radius from.
# Same value as FLEET_SECRET on the system API. Never exposed to the browser.
FLEET_SECRET=REPLACE_WITH_THE_SAME_FLEET_SECRET_AS_SYSTEM_API
# Labels the brokered token; any value matching the API's device-id pattern.
CONSOLE_DEVICE_ID=labelling-console


