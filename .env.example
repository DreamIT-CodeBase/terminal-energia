# Azure Blob Storage account that holds the debug directories.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=memoryterminalscout;AccountKey=REPLACE_WITH_REAL_KEY;EndpointSuffix=core.windows.net

# Source data: video-id/{frames,crops,prepped}/, video-id/api_response.json, video-id/video.mp4
SOURCE_CONTAINER=debugdirectory

# Destination for annotated images and YOLO labels: video-id/images/, video-id/labels/
ANNOTATED_CONTAINER=debugdirectoryannotated

# Shared key the labelling UI server sends as the x-api-key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYSTEM_API_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# Comma separated origins allowed to call this API directly.
ALLOWED_ORIGINS=http://localhost:3000


# ============================================================
# MICROSOFT FABRIC LAKEHOUSE
#
# JSON documents land at
#   <lakehouse>/Files/vehicle=<vehicle>/date=<date>/<uuid>.json
# ============================================================

# Service principal (Entra ID app registration).
# It needs Contributor, or at least Write, on the Fabric workspace.
# Leave all three empty to fall back to managed identity / az login.
AZURE_TENANT_ID=REPLACE_WITH_TENANT_ID
AZURE_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# GUIDs taken from the lakehouse URL:
# https://app.fabric.microsoft.com/groups/<WORKSPACE>/lakehouses/<LAKEHOUSE>
FABRIC_WORKSPACE=5f5fe33e-5253-44d9-be78-1efe5ae840f5
FABRIC_LAKEHOUSE=a836f844-5e9e-4919-a021-df26cfa6ab87

# Root inside the lakehouse that the vehicle=/date= partitions hang off.
FABRIC_ROOT_PATH=Files

# OneLake DFS endpoint. Change only for sovereign clouds.
ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com

# ============================================================
# DEVICE API (/v1)
#
# Replaces the storage account key that used to ship in the
# APK: devices authenticate here and get short-lived,
# single-blob SAS URLs instead.
# ============================================================

# Signs the device tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# One secret shared by the whole fleet, embedded in the APK. Empty means no
# device can authenticate, which fails closed. Rotating it revokes every
# device at once, so it needs an app release to go with it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLEET_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# How long a device token lasts.
DEVICE_TOKEN_TTL_SECONDS=3600

# Upload SAS lifetime: minutes, since it is requested per artifact.
ARTIFACT_SAS_TTL_SECONDS=900

# Model SAS lifetime: longer, because the downloads are large.
MODEL_SAS_TTL_SECONDS=3600

# Containers the model endpoint may serve from, comma separated. Models are
# addressed as <container>/<blob>, e.g. yolo/board-detection-001.tflite.
MODEL_CONTAINERS=llm,yolo

# Where the device configuration document lives. /v1/config returns this blob
# whole, so retuning the fleet is an edit here rather than an app release.
DEVICE_CONFIG_CONTAINER=configurations
DEVICE_CONFIG_BLOB=device-config/device-config.default.json

# Where the station list lives. The fleet writes to this document as well as
# reading it, so it is a blob rather than a file in the image.
STATIONS_CONTAINER=configurations
STATIONS_BLOB=stations-data/stations.json
STATIONS_ENRICHED_BLOB=stations-data/stations-enriched.json

# How long a worker may serve the station list from memory. A write busts its
# own cache, so this only bounds how stale a *different* worker can be.
STATIONS_CACHE_TTL_SECONDS=60

# An upsert rewrites the whole document under an etag check. This bounds how
# many times it re-reads and reapplies after losing a race.
STATIONS_WRITE_ATTEMPTS=5
